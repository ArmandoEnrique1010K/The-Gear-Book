properties:
  file.folder:
    displayName: Tema
  note.tags:
    displayName: tema
views:
  - type: table
    name: Tabla
    filters:
      and:
        - file.ext == "md"
    groupBy:
      property: file.folder
      direction: ASC
    order:
      - file.name
      - orden
      - file.ctime
      - tags
      - Comentario
      - estado
    sort:
      - property: orden
        direction: ASC
      - property: tags
        direction: DESC
      - property: file.basename
        direction: ASC
      - property: number
        direction: ASC
    columnSize:
      file.name: 263
      note.orden: 90
  - type: cards
    name: Vista
