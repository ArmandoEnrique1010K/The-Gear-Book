properties:
  file.folder:
    displayName: Tema
views:
  - type: table
    name: Tabla
    filters:
      and:
        - file.ext == "md"
    groupBy:
      property: file.folder
      direction: ASC
    order:
      - file.name
      - file.folder
      - number
      - file.ctime
    sort:
      - property: file.basename
        direction: ASC
      - property: number
        direction: ASC
    columnSize:
      file.folder: 100
      note.number: 111
  - type: cards
    name: Vista
